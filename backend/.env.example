# Searvo Backend Environment Variables

# Service URLs (defaults for Docker Compose network)
SEARXNG_URL=http://searxng:8080
QDRANT_URL=http://qdrant:6333
PORT=8000
HOST=0.0.0.0

# Optional Global LLM API Keys (If not supplied per-request by client BYOK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default models
DEFAULT_REASONING_MODEL=gpt-4o-mini
DEFAULT_GENERATION_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
